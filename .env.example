# ---------------------------------------------------------------
# Song Shout — environment variables
# ---------------------------------------------------------------
# Never commit real values. Copy this file to `.env.local` for
# local development and fill in real values.

# Supabase (public — safe for the browser)
# The key may be provided under either name; the new-style publishable key
# (sb_publishable_…) is preferred. Any one of the two is required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-only — NEVER expose to the browser)
# DISABLED for future development (2026-08-20): auth is username-based and no
# app-level email is sent. Re-enable when email delivery is wanted.
# Get a key at https://resend.com/api-keys
# RESEND_API_KEY=

# App base URL (public)
NEXT_PUBLIC_APP_URL=http://localhost:3000